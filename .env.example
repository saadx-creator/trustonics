# Production: managed PostgreSQL connection string (TLS required by your provider).
DATABASE_URL=
# Local embedded PostgreSQL only; never enable on Vercel.
LOCAL_DATABASE=1
PGLITE_DIR=.data/postgres
# Generate with openssl rand -base64 32. setup:local does this automatically.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Production canonical URL is mandatory. Do not derive it from request headers.
APP_URL=http://localhost:3000
# Digits only, e.g. 923001234567. Empty hides every business WhatsApp button.
NEXT_PUBLIC_TRUSTONICS_WHATSAPP=
# Enable only behind a proxy that overwrites incoming X-Forwarded-For.
TRUST_PROXY=0
